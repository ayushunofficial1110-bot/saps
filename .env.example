# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB Atlas connection string (e.g. mongodb+srv://admin:password@cluster.mongodb.net/saps_erp)
# If not provided, the server uses a built-in persistent in-memory data store with preloaded records.
MONGODB_URI=""

# META_WHATSAPP_PHONE_NUMBER_ID: Phone Number ID from Meta WhatsApp Business Platform
META_WHATSAPP_PHONE_NUMBER_ID=""

# META_WHATSAPP_ACCESS_TOKEN: Permanent or System User Access Token from Meta Developer Portal
META_WHATSAPP_ACCESS_TOKEN=""

# META_WHATSAPP_TEMPLATE_NAME: Pre-approved template name (e.g., student_absent_alert)
META_WHATSAPP_TEMPLATE_NAME="student_absent_alert"

# JWT_SECRET: Secret used for signing authentication tokens
JWT_SECRET="saps_secure_jwt_secret_up_board_2025"

# ADMIN_USERNAME: Username for the School Administrator account in ERP portal (default: admin)
ADMIN_USERNAME=admin

# ADMIN_PASSWORD: Secret password for the School Administrator account (configure in AI Studio Secrets)
ADMIN_PASSWORD=

# ADMIN_SECURITY_QUESTION: Optional recovery question for admin password reset (default: What is your favorite teacher's name?)
ADMIN_SECURITY_QUESTION=

# ADMIN_SECURITY_ANSWER: Optional recovery answer for admin password reset (default: Sharma)
ADMIN_SECURITY_ANSWER=
